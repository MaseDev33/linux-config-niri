{
  "layer": "top",
  "position": "top",
  "height": 44,
  "spacing": 0,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "custom/launcher",
    "niri/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "bluetooth",
    "pulseaudio",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "tray",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/launcher.sh",
    "on-click-right": "~/.config/waybar/scripts/run.sh"
  },
  "niri/workspaces": {
    "format": "{index}",
    "disable-scroll": false
  },
  "clock": {
    "format": "{:%a  %d %b  %H:%M}",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "network": {
    "format-wifi": "󰤨  {signalStrength}%",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Wi-Fi disconnected",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/wifi-menu",
    "on-click-right": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\n{status}",
    "on-click": "~/.config/waybar/scripts/bluetooth.sh",
    "on-click-right": "bluetoothctl power off"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰖀"]
    },
    "on-click": "~/.config/waybar/scripts/audio.sh",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "scroll-step": 5
  },
  "cpu": {
    "interval": 2,
    "format": "󰻠 {usage}%",
    "states": {
      "warning": 65,
      "critical": 90
    },
    "on-click": "kitty -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "on-click": "kitty -e btop"
  },
  "temperature": {
    "critical-threshold": 85,
    "interval": 5,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C"
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu",
    "on-click": "~/.config/waybar/scripts/power-menu"
  }
}
